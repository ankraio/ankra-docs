{
  "comment": "One row per step of the flow on /use-cases/from-prompt-and-code-to-production. Edit here and run: node scripts/check_flow_parity.mjs --write. A cell is available (ui: page and action; cli: commands; mcp: tools) or a gap, which must say why. bead names the tracker issue when it is meant to close; it stays here and is not published.",
  "steps": [
    {
      "step": "Connect GitHub",
      "ui": { "page": "/organisation/integrations", "action": "Source control, install the Ankra GitHub App" },
      "cli": { "gap": "Installing a GitHub App is a browser consent. Register a repository once the connection exists.", "bead": "ankra-oznf7k.28" },
      "mcp": { "gap": "By design: a credential is never created over MCP, because the secret would be a tool argument." }
    },
    {
      "step": "Register the repository",
      "ui": { "page": "/applications/create", "action": "Choose a repository, Create application" },
      "cli": { "commands": ["ankra application add", "ankra application ship"] },
      "mcp": { "tools": ["create_application"] }
    },
    {
      "step": "Read the setup pull request",
      "ui": { "page": "/applications/[id]", "action": "Ship, Go live" },
      "cli": { "commands": ["ankra application add"], "flags": { "ankra application add": ["--wait"] } },
      "mcp": { "tools": ["get_application_setup_proposal"] }
    },
    {
      "step": "Approve pipeline authority",
      "ui": { "page": "/applications/[id]", "action": "Pipelines, Approve" },
      "cli": { "commands": ["ankra pipeline definitions approve"] },
      "mcp": { "gap": "By design: only a person approves what a pipeline may do." }
    },
    {
      "step": "Watch a run",
      "ui": { "page": "/applications/[id]", "action": "Pipelines" },
      "cli": { "commands": ["ankra pipeline get", "ankra pipeline logs"], "flags": { "ankra pipeline get": ["--wait"] } },
      "mcp": { "tools": ["watch_pipeline_run", "get_pipeline_step_logs"] }
    },
    {
      "step": "Read findings",
      "ui": { "page": "/applications/[id]", "action": "Protect" },
      "cli": { "commands": ["ankra pipeline findings", "ankra application container-security"] },
      "mcp": { "tools": ["get_application_container_security", "list_security_findings"] }
    },
    {
      "step": "AI fix, with approval",
      "ui": { "page": "/applications/[id]", "action": "Protect, Fix" },
      "cli": { "commands": ["ankra chat", "ankra chat actions confirm"] },
      "mcp": { "gap": "No tool starts Ankra AI's fix. The connected client writes the change itself and opens a pull request with scm_create_pull_request.", "bead": "ankra-oznf7k.13" }
    },
    {
      "step": "Merge",
      "ui": { "gap": "Merging happens on GitHub; the page links to the pull request.", "bead": "ankra-oznf7k.29" },
      "cli": { "gap": "No merge verb; the merge train is the only route and must be enabled.", "bead": "ankra-oznf7k.4" },
      "mcp": { "tools": ["scm_merge_pull_request"], "note": "Refused while merge-when-green is off for the connection.", "bead": "ankra-oznf7k.13" }
    },
    {
      "step": "Deploy with Postgres",
      "ui": { "page": "/applications/[id]/deploy", "action": "Deploy a version" },
      "cli": { "commands": ["ankra application ship"], "flags": { "ankra application ship": ["--set-up-database"] } },
      "mcp": { "tools": ["deploy_application", "prepare_service_setup", "confirm_service_setup"], "note": "Cannot yet install the Postgres operator on a cluster without one.", "bead": "ankra-oznf7k.13" }
    },
    {
      "step": "Public address",
      "ui": { "page": "/applications/[id]/deploy", "action": "Public access, Public hostname" },
      "cli": { "commands": ["ankra application deploy"], "flags": { "ankra application deploy": ["--set"] } },
      "mcp": { "tools": ["deploy_application"] }
    },
    {
      "step": "Pull request previews",
      "ui": { "page": "/applications/[id]", "action": "Ship, Previews" },
      "cli": { "commands": ["ankra application demo config set", "ankra application demo deploy"] },
      "mcp": { "tools": ["update_application_demo_config", "deploy_pr_demo"] },
      "note": "Open bug on every surface: a preview on Ankra Cloud does not come up.", "bead": "ankra-oznf7k.22"
    },
    {
      "step": "AI review",
      "ui": { "page": "/organisation/integrations", "action": "Source control, repository rules" },
      "cli": { "commands": ["ankra org ai-review repos set", "ankra application pull-request-reviews"] },
      "mcp": { "tools": ["list_application_pull_request_reviews"], "note": "Reads reviews. Turning review on for a repository is not a tool.", "bead": "ankra-oznf7k.30" }
    },
    {
      "step": "Promote",
      "ui": { "page": "/applications/[id]", "action": "Ship, Promote a version" },
      "cli": { "commands": ["ankra application deploy"], "flags": { "ankra application deploy": ["--set"] }, "note": "No promote verb: deploy the tag that passed.", "bead": "ankra-oznf7k.11" },
      "mcp": { "tools": ["promote_application"] }
    },
    {
      "step": "Roll back",
      "ui": { "page": "/applications/[id]", "action": "Ship, Put back" },
      "cli": { "commands": ["ankra application deploy"], "flags": { "ankra application deploy": ["--set"] }, "note": "Deploy the previous tag." },
      "mcp": { "tools": ["deploy_application"], "note": "Deploy the previous tag." }
    },
    {
      "step": "Connect Slack",
      "ui": { "page": "/organisation/integrations", "action": "Chat apps, Slack" },
      "cli": { "gap": "No install verb; the browser sign-in starts from the portal.", "bead": "ankra-oznf7k.11" },
      "mcp": { "gap": "Slack's install is a browser consent, so no tool starts it.", "bead": "ankra-oznf7k.31" }
    },
    {
      "step": "Route alerts",
      "ui": { "page": "/organisation/notification-routes", "action": "Add a route" },
      "cli": { "commands": ["ankra alerts destinations create", "ankra alerts routes create"] },
      "mcp": { "tools": ["create_alert_destination", "create_notification_route"] }
    },
    {
      "step": "AI sandbox",
      "ui": { "page": "/organisation/ai-workspaces", "action": "Choose the cluster" },
      "cli": { "commands": ["ankra org ai-environment set", "ankra cluster node-group add"], "note": "A new CI cluster needs a labelled node group first.", "bead": "ankra-oznf7k.2" },
      "mcp": { "tools": ["update_ai_environment", "add_node_group"] }
    },
    {
      "step": "CI cluster",
      "ui": { "page": "/organisation/pipelines", "action": "CI cluster pool" },
      "cli": { "commands": ["ankra org ci-settings pool add"] },
      "mcp": { "gap": "No tool changes the organisation's CI cluster pool.", "bead": "ankra-oznf7k.32" }
    }
  ]
}
